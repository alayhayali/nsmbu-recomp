{
  "$schema": "../../sdk/manifest.schema.json",
  "format_version": 2,
  "id": "example.powerup-storage",
  "name": "Power-up storage",
  "version": "0.1.0",
  "game_id": "nsmbu-usa",
  "description": "Keeps the power-up you walk into while already powered and lets you use it later with a button press.",
  "kind": "lua",
  "lua": {
    "api_version": 1,
    "entry": "main.lua"
  },
  "options": [
    {
      "id": "use_button",
      "name": "Use stored power-up",
      "type": "enum",
      "default": "Minus",
      "choices": ["Minus", "Plus", "L", "R", "ZL", "ZR", "X", "Y"]
    },
    {
      "id": "show_hud",
      "name": "Show reserve box",
      "type": "bool",
      "default": true
    }
  ]
}
