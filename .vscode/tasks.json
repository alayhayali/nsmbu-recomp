{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "modding: watch",
            "type": "shell",
            "command": "npm run watch",
            "options": {
                "cwd": "${workspaceFolder}/modding"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": ["relative", "${workspaceFolder}/modding"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (TS\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting compilation in watch mode",
                    "endsPattern": "Found 0 errors|Found \\d+ errors|Compilation complete"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
